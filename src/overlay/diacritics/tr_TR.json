{
    "version": 1,
    "locale": "tr_TR",
    "description": "Turkish — prioritizes ç, ğ, ş, ö, ü; adds dotless ı; lira sign first under $",
    "map": {
        "a": ["â", "ä", "á"],
        "c": ["ç", "č", "ć"],
        "ç": ["č"],
        "e": ["ə", "ä", "é", "ê", "ë"],
        "g": ["ğ", "ġ"],
        "i": ["î", "ı", "í", "ì", "ï", "ī", "į"],
        "n": ["ñ", "ň", "ń", "ŋ", "№"],
        "o": ["ö", "ó", "ò", "ô", "õ", "ō", "ø", "ő", "œ"],
        "s": ["ş", "š", "ś", "ß"],
        "ş": ["š"],
        "u": ["ü", "û", "ū", "ú", "ù", "ů", "ű", "ų"],
        "y": ["ý"],
        "$": ["₺", "€", "£", "¥", "¢", "₹"]
    }
}
